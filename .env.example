# ログイン認証。両方コメントアウトのままなら認証は無効（Tailscale だけで守る）。
# ハッシュの作り方:
#   docker compose run --rm --entrypoint java kurohon -cp bin com.pereperia.web.Auth 好きなパスワード
#KUROHON_USER=me
#KUROHON_PASSWORD_HASH=210000$....$....

# ログインを保持する日数
#KUROHON_SESSION_DAYS=30

# progress.md の出力先。Docker ではホストから見える data/ に出す
PROGRESS_OUT=data/progress.md
